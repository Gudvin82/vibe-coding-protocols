      "merge_only_files": [
        "PROJECT_MAP.md",
        "templates/ARCHITECTURE_SOURCE_OF_TRUTH.md"
      ],
      "skip_files": [
        "SECURITY.md",
        ".env",
        "package.json",
        "pyproject.toml",
        ".github/workflows"
      ],
      "skip_conditions": [
        "No release gate evidence exists",
        "Independent review path is unavailable"
      ],
      "validation_commands": [
        "bash scripts/vibe-check.sh --audit --json",
        "python3 -m vcp_cli review plan --json"
      ],
      "expected_report_template": [
        "templates/reports/vcp-adoption-assessment.md",
        "templates/reports/code-review-report.md"
      ],
      "review_gate_requirement": "Required before merge/release.",
      "next_safe_step": "Lock review scope and release gate before modifications."
    },
