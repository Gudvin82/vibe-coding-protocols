{
  "id": "post-task-review",
  "type": "adoption_pack",
  "name": "Post-Task Review Pack",
  "summary": "Scoped adoption pack for post-task review pack.",
  "use_when": [
    "active diff needs acceptance"
  ],
  "do_not_use_when": [
    "full hardening scope is still unresolved"
  ],
  "risk_level": "high",
  "domains": [
    "adoption-pack"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "no review gate"
    ],
    "project_state": [
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "protocols/review/post-task-code-review.md",
    "commands/loop-code-review.md",
    "templates/prompts/loop-code-review.md",
    "templates/reports/code-review-report.md"
  ],
  "related_files": [
    "AI_INTAKE.md"
  ],
  "cli": [
    "python3 -m vcp_cli adopt --pack post-task-review --dry-run"
  ],
  "outputs": [
    "adoption dry-run plan"
  ],
  "stop_conditions": [
    "Validation is red"
  ],
  "validation": [
    "python3 -m vcp_cli review plan --json",
    "python3 -m vcp_cli check --fast"
  ],
  "version": "v0.9.1",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "adoption_pack",
    "adoption-pack",
    "review-gate"
  ]
}
