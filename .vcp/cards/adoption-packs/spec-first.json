{
  "id": "spec-first",
  "type": "adoption_pack",
  "name": "Spec-first Pack",
  "summary": "Scoped pack for teams that need PRD/spec/tasks discipline before implementation.",
  "use_when": [
    "feature is still ambiguous",
    "acceptance criteria need to be explicit"
  ],
  "do_not_use_when": [
    "trivial fix",
    "live incident response"
  ],
  "risk_level": "medium",
  "domains": [
    "planning",
    "spec-driven-delivery"
  ],
  "maps_to": {
    "sdlc_phase": [
      "idea",
      "planning"
    ],
    "ai_failure_modes": [
      "implementation before scope clarity"
    ],
    "project_state": [
      "new",
      "existing MVP"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "docs/adoption-packs.md"
  ],
  "related_files": [
    "templates/specs/PRD.md",
    "PROJECT_BACKLOG.md"
  ],
  "cli": [
    "python3 -m vcp_cli adopt --pack spec-first --dry-run --json"
  ],
  "outputs": [
    "adoption dry run"
  ],
  "stop_conditions": [
    "Tiny change does not need spec overhead"
  ],
  "validation": [
    "python3 -m vcp_cli spec validate"
  ],
  "version": "v0.6.1",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "adoption_pack",
    "spec"
  ]
}
