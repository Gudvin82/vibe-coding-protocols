{
  "id": "new-project",
  "type": "adoption_pack",
  "name": "New Project Pack",
  "summary": "Scoped adoption pack for new project pack.",
  "use_when": [
    "idea stage",
    "new MVP"
  ],
  "do_not_use_when": [
    "production repo already exists"
  ],
  "risk_level": "low",
  "domains": [
    "adoption-pack"
  ],
  "maps_to": {
    "sdlc_phase": [
      "idea",
      "planning"
    ],
    "ai_failure_modes": [
      "no product brief"
    ],
    "project_state": [
      "new"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "START_HERE.md",
    "templates/AGENTS.md",
    "templates/PROJECT_MAP.md",
    "protocols/ai-project-starter-protocol.md"
  ],
  "related_files": [
    "docs/lite-adoption-path.md",
    "templates/ARCHITECTURE_MAP.md",
    "protocols/integrations/third-party-api-intake.md",
    "docs/two-track-model.md",
    "docs/spec-foundation.md",
    "docs/spec-quality-gate.md"
  ],
  "cli": [
    "python3 -m vcp_cli adopt --pack new-project --dry-run"
  ],
  "outputs": [
    "adoption dry-run plan"
  ],
  "stop_conditions": [
    "Production users already exist",
    "Review external APIs before implementation."
  ],
  "validation": [
    "bash scripts/vibe-check.sh --starter"
  ],
  "version": "v0.6.7",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "adoption_pack",
    "adoption-pack"
  ]
}
