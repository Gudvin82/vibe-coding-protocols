{
  "id": "saas-ai-mvp-hardening-pack",
  "type": "adoption_pack",
  "name": "SaaS AI-MVP Hardening Pack",
  "summary": "Scoped pack for hardening an AI-generated SaaS MVP without pretending the repo is already production-safe.",
  "use_when": [
    "AI-generated SaaS MVP needs visible auth, billing, contracts, and release controls"
  ],
  "do_not_use_when": [
    "the project is still only an idea"
  ],
  "risk_level": "high",
  "domains": [
    "adoption-pack"
  ],
  "maps_to": {
    "sdlc_phase": [
      "hardening"
    ],
    "ai_failure_modes": [
      "contract drift",
      "release overclaim"
    ],
    "project_state": [
      "existing MVP"
    ],
    "risk_categories": [
      "delivery chaos",
      "auth and billing ambiguity"
    ]
  },
  "entry_files": [
    "docs/adoption-packs/saas-ai-mvp-hardening.md",
    "docs/demos/contracts-first-ai-mvp.md"
  ],
  "related_files": [
    "docs/pr-gate-approval-model.md",
    "docs/project-memory.md"
  ],
  "cli": [
    "python3 -m vcp_cli adopt plan --pack saas-ai-mvp-hardening --json"
  ],
  "outputs": [
    "adoption plan"
  ],
  "stop_conditions": [
    "Auth, billing, or contract ownership is still unknown"
  ],
  "validation": [
    "python3 -m vcp_cli classify --json",
    "python3 -m vcp_cli release-check --json"
  ],
  "version": "v0.9.4",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "adoption_pack",
    "saas",
    "mvp"
  ]
}
