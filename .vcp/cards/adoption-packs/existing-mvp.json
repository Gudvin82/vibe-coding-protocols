{
  "id": "existing-mvp",
  "type": "adoption_pack",
  "name": "Existing MVP Pack",
  "summary": "Scoped adoption pack for existing mvp pack.",
  "use_when": [
    "working app before production"
  ],
  "do_not_use_when": [
    "payments or personal data already exist"
  ],
  "risk_level": "medium",
  "domains": [
    "adoption-pack"
  ],
  "maps_to": {
    "sdlc_phase": [
      "hardening"
    ],
    "ai_failure_modes": [
      "no validation"
    ],
    "project_state": [
      "existing MVP"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "docs/adoption-packs.md",
    "templates/AUDIT_BACKLOG.md",
    "templates/SECURITY_BASELINE.md"
  ],
  "related_files": [
    "protocols/maintenance/care-refactoring.md",
    "protocols/review/post-task-code-review.md",
    "templates/THIRD_PARTY_REGISTRY.md",
    "PROJECT_MAP.md"
  ],
  "cli": [
    "python3 -m vcp_cli adopt --pack existing-mvp --dry-run"
  ],
  "outputs": [
    "adoption dry-run plan"
  ],
  "stop_conditions": [
    "No validation path exists"
  ],
  "validation": [
    "bash scripts/vibe-check.sh --hardening",
    "python3 -m vcp_cli review plan --json"
  ],
  "version": "v0.7.1",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "adoption_pack",
    "adoption-pack"
  ]
}
