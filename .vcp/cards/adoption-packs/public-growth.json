{
  "id": "public-growth-pack",
  "type": "adoption_pack",
  "name": "Public Growth Pack",
  "summary": "Scoped adoption pack for public growth pack.",
  "use_when": [
    "public service pages",
    "commercial content structure",
    "GEO and AI visibility work"
  ],
  "do_not_use_when": [
    "the plan depends on hidden content, spam, or fabricated proof"
  ],
  "risk_level": "medium",
  "domains": [
    "adoption-pack"
  ],
  "maps_to": {
    "sdlc_phase": [
      "growth"
    ],
    "ai_failure_modes": [
      "public growth without baseline"
    ],
    "project_state": [
      "public site",
      "production"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "protocols/public-growth/public-growth-playbook.md",
    "protocols/public-growth/seo-geo-ai-visibility.md",
    "protocols/public-growth/page-template-system.md",
    "protocols/public-growth/public-growth-risk-control.md",
    "docs/geo-ai-visibility.md",
    "docs/page-templates.md",
    "templates/public-growth/page-brief.md",
    "templates/public-growth/public-growth-checklist.md",
    "templates/reports/public-growth-audit-report.md"
  ],
  "related_files": [
    "templates/public-growth/ai-visibility-queries.md",
    "templates/public-growth/schema/README.md",
    "templates/reports/ai-visibility-monitoring-report.md",
    "docs/public-site-readiness.md",
    "llms.txt",
    "llms.txt"
  ],
  "cli": [
    "python3 -m vcp_cli adopt --pack public-growth --dry-run"
  ],
  "outputs": [
    "adoption dry-run plan"
  ],
  "stop_conditions": [
    "The plan depends on guaranteed rankings or AI citations",
    "Visible claims, schema, and FAQ content do not match",
    "The page strategy would create doorway pages, fake reviews, or hidden FAQ content"
  ],
  "validation": [
    "python3 scripts/check-newlines.py",
    "python3 scripts/validate-links.sh",
    "python3 -m vcp_cli review plan --json"
  ],
  "version": "v0.5.8"
}
