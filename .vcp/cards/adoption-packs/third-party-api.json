{
  "id": "third-party-api",
  "type": "adoption_pack",
  "name": "Third-party API Pack",
  "summary": "Scoped adoption pack for third-party api pack.",
  "use_when": [
    "an external API, SDK, SaaS integration or webhook is being proposed"
  ],
  "do_not_use_when": [
    "no third-party system is involved"
  ],
  "risk_level": "high",
  "domains": [
    "adoption-pack"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "implementation"
    ],
    "ai_failure_modes": [
      "unsafe external API"
    ],
    "project_state": [
      "production",
      "regulated"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "protocols/integrations/third-party-api-intake.md",
    "commands/third-party-api-intake.md",
    "templates/prompts/third-party-api-intake.md",
    "templates/reports/third-party-api-intake-report.md",
    "templates/THIRD_PARTY_REGISTRY.md",
    "protocols/review/post-task-code-review.md"
  ],
  "related_files": [
    "templates/examples/THIRD_PARTY_REGISTRY.filled.example.md",
    "docs/security-methodology-scope.md",
    "PROJECT_BACKLOG.md",
    "PROJECT_MAP.md"
  ],
  "cli": [
    "python3 -m vcp_cli adopt --pack third-party-api --dry-run"
  ],
  "outputs": [
    "adoption dry-run plan"
  ],
  "stop_conditions": [
    "Terms, quota, data flow or fallback are still unknown",
    "A secret would be committed to code or prompts"
  ],
  "validation": [
    "python3 -m vcp_cli check --fast --json",
    "python3 -m vcp_cli review plan --json"
  ],
  "version": "v0.6.7",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "adoption_pack",
    "adoption-pack"
  ]
}
