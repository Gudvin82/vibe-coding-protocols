{
  "id": "production",
  "type": "adoption_pack",
  "name": "Production Pack",
  "summary": "Scoped adoption pack for production pack.",
  "use_when": [
    "real users",
    "public product"
  ],
  "do_not_use_when": [
    "there is no running product yet"
  ],
  "risk_level": "high",
  "domains": [
    "adoption-pack"
  ],
  "maps_to": {
    "sdlc_phase": [
      "hardening",
      "release"
    ],
    "ai_failure_modes": [
      "no review gate",
      "no validation"
    ],
    "project_state": [
      "production"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "AI_INTAKE.md",
    "templates/reports/security-review-scope.md",
    "protocols/review/post-task-code-review.md",
    "templates/reports/code-review-report.md",
    "templates/SECURITY_OPERATIONS_BASELINE.md",
    "PROJECT_BACKLOG.md"
  ],
  "related_files": [
    "templates/INCIDENT_RECOVERY_RUNBOOK.md",
    "templates/THIRD_PARTY_REGISTRY.md",
    "protocols/integrations/third-party-api-intake.md",
    "protocols/operations/production-error-capture.md",
    "PROJECT_MAP.md",
    "templates/ARCHITECTURE_SOURCE_OF_TRUTH.md"
  ],
  "cli": [
    "python3 -m vcp_cli adopt --pack production --dry-run"
  ],
  "outputs": [
    "adoption dry-run plan"
  ],
  "stop_conditions": [
    "No release gate evidence exists",
    "Independent review path is unavailable"
  ],
  "validation": [
    "bash scripts/vibe-check.sh --audit --json",
    "python3 -m vcp_cli review plan --json"
  ],
  "version": "v0.9.2",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "adoption_pack",
    "adoption-pack"
  ]
}
