{
  "id": "post-task-code-review",
  "type": "route",
  "name": "Post-Task Code Review",
  "summary": "Use when meaningful AI-generated changes need an explicit acceptance gate.",
  "use_when": [
    "active diff needs acceptance"
  ],
  "do_not_use_when": [
    "full security audit is required"
  ],
  "risk_level": "high",
  "domains": [
    "review"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review",
      "release"
    ],
    "ai_failure_modes": [
      "no review gate"
    ],
    "project_state": [
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "delivery chaos",
      "security"
    ]
  },
  "entry_files": [
    "protocols/review/post-task-code-review.md",
    "commands/loop-code-review.md"
  ],
  "related_files": [
    "templates/reports/code-review-report.md"
  ],
  "cli": [
    "python3 -m vcp_cli review plan"
  ],
  "outputs": [
    "review plan",
    "acceptance report"
  ],
  "stop_conditions": [
    "validation is red"
  ],
  "validation": [
    "python3 -m vcp_cli check --fast"
  ],
  "version": "v0.6.2",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "route",
    "review",
    "review-gate"
  ]
}
