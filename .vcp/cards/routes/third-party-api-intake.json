{
  "id": "third-party-api-intake",
  "type": "route",
  "name": "Third-party API Intake",
  "summary": "Use before adding an external API, SDK, webhook, or SaaS dependency.",
  "use_when": [
    "external API proposed"
  ],
  "do_not_use_when": [
    "no external system is involved"
  ],
  "risk_level": "high",
  "domains": [
    "integrations"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "implementation",
      "review"
    ],
    "ai_failure_modes": [
      "unsafe external API"
    ],
    "project_state": [
      "existing MVP",
      "production",
      "regulated"
    ],
    "risk_categories": [
      "security",
      "privacy/data",
      "compliance/legal"
    ]
  },
  "entry_files": [
    "protocols/integrations/third-party-api-intake.md",
    "commands/third-party-api-intake.md"
  ],
  "related_files": [
    "templates/THIRD_PARTY_REGISTRY.md",
    "templates/reports/third-party-api-intake-report.md"
  ],
  "cli": [
    "python3 -m vcp_cli route --profile third-party-api"
  ],
  "outputs": [
    "intake report",
    "registry decision"
  ],
  "stop_conditions": [
    "owner/auth/data flow unknown"
  ],
  "validation": [
    "python3 -m vcp_cli check --fast --json"
  ],
  "version": "v0.9.3",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "route",
    "integrations"
  ]
}
