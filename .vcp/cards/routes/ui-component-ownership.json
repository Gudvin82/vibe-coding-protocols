{
  "id": "ui-component-ownership",
  "type": "route",
  "name": "UI Component Ownership",
  "summary": "Use when UI styling or ownership drift needs a narrow cleanup slice.",
  "use_when": [
    "page-level styling drift",
    "component ownership drift"
  ],
  "do_not_use_when": [
    "broad redesign"
  ],
  "risk_level": "variable",
  "domains": [
    "frontend"
  ],
  "maps_to": {
    "sdlc_phase": [
      "implementation",
      "review"
    ],
    "ai_failure_modes": [
      "no validation"
    ],
    "project_state": [
      "existing MVP",
      "public site"
    ],
    "risk_categories": [
      "maintainability",
      "public visibility"
    ]
  },
  "entry_files": [
    "protocols/maintenance/ui-refactoring.md"
  ],
  "related_files": [
    "templates/reports/ui-refactoring-report.md"
  ],
  "cli": [
    "python3 -m vcp_cli route --profile ui-ownership"
  ],
  "outputs": [
    "UI ownership route recommendation"
  ],
  "stop_conditions": [
    "whole-system redesign is really requested"
  ],
  "validation": [
    "typecheck",
    "python3 -m vcp_cli review plan --json"
  ],
  "version": "v0.8.9",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "route",
    "frontend"
  ]
}
