{
  "id": "production-error-capture",
  "type": "route",
  "name": "Production Error Capture",
  "summary": "Use when production evidence must be captured without mutating system state.",
  "use_when": [
    "production errors must be observed"
  ],
  "do_not_use_when": [
    "task expects remediation or deploy changes"
  ],
  "risk_level": "medium",
  "domains": [
    "operations"
  ],
  "maps_to": {
    "sdlc_phase": [
      "operations"
    ],
    "ai_failure_modes": [
      "production logs ignored"
    ],
    "project_state": [
      "production"
    ],
    "risk_categories": [
      "operations",
      "security"
    ]
  },
  "entry_files": [
    "protocols/operations/production-error-capture.md",
    "commands/prod-log-monitor.md"
  ],
  "related_files": [
    "templates/reports/production-error-capture-report.md"
  ],
  "cli": [
    "python3 -m vcp_cli route --profile operations"
  ],
  "outputs": [
    "capture report"
  ],
  "stop_conditions": [
    "no authorized log path exists"
  ],
  "validation": [
    "python3 -m vcp_cli doctor"
  ],
  "version": "v0.8.2",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "route",
    "operations"
  ]
}
