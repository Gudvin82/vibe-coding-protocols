{
  "id": "spec-first-feature",
  "type": "route",
  "name": "Spec-first Feature",
  "summary": "Use when an idea or feature request needs PRD, acceptance criteria, and tasks before coding.",
  "use_when": [
    "idea without PRD",
    "unclear feature request",
    "acceptance criteria needed before implementation"
  ],
  "do_not_use_when": [
    "tiny one-line fix",
    "pure formatting",
    "emergency incident response"
  ],
  "risk_level": "medium",
  "domains": [
    "spec-driven-delivery",
    "planning"
  ],
  "maps_to": {
    "sdlc_phase": [
      "idea",
      "planning"
    ],
    "ai_failure_modes": [
      "no product brief",
      "implementation before scope clarity"
    ],
    "project_state": [
      "new",
      "existing MVP"
    ],
    "risk_categories": [
      "delivery chaos",
      "scope drift"
    ]
  },
  "entry_files": [
    "protocols/spec-driven/README.md",
    "templates/specs/PRD.md"
  ],
  "related_files": [
    "PROJECT_BACKLOG.md",
    "protocols/review/post-task-code-review.md"
  ],
  "cli": [
    "python3 -m vcp_cli route --profile spec-first --json"
  ],
  "outputs": [
    "spec-first route recommendation"
  ],
  "stop_conditions": [
    "The feature is still ambiguous after questions",
    "The change is too small for a full spec lane"
  ],
  "validation": [
    "python3 -m vcp_cli spec validate",
    "python3 -m vcp_cli backlog validate"
  ],
  "version": "v0.9.1",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "route",
    "spec",
    "planning"
  ]
}
