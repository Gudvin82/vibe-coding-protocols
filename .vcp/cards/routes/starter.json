{
  "id": "starter",
  "type": "route",
  "name": "Starter Protocol",
  "summary": "Use when a new idea or MVP needs initial route discipline.",
  "use_when": [
    "new project",
    "new MVP"
  ],
  "do_not_use_when": [
    "production repo already exists"
  ],
  "risk_level": "medium",
  "domains": [
    "project-bootstrap"
  ],
  "maps_to": {
    "sdlc_phase": [
      "idea",
      "planning"
    ],
    "ai_failure_modes": [
      "no product brief"
    ],
    "project_state": [
      "new"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "START_HERE.md",
    "protocols/ai-project-starter-protocol.md"
  ],
  "related_files": [
    "templates/AGENTS.md",
    "templates/PROJECT_MAP.md"
  ],
  "cli": [
    "python3 -m vcp_cli route --profile new-project"
  ],
  "outputs": [
    "starter route recommendation"
  ],
  "stop_conditions": [
    "production users already exist"
  ],
  "validation": [
    "bash scripts/vibe-check.sh --starter"
  ],
  "version": "v0.9.1",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "route",
    "project-bootstrap"
  ]
}
