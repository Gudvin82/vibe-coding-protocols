{
  "id": "repository-evaluation",
  "type": "route",
  "name": "Repository Evaluation",
  "summary": "Use when VCP itself is being evaluated and shallow README-only judgment must be avoided.",
  "use_when": [
    "evaluate VCP itself"
  ],
  "do_not_use_when": [
    "README-only skim treated as complete"
  ],
  "risk_level": "medium",
  "domains": [
    "evaluation"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "review"
    ],
    "ai_failure_modes": [
      "README-only evaluation"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production",
      "public site"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "AGENTS.md",
    "AI_EVALUATION_GUIDE.md",
    ".vcp/index.json"
  ],
  "related_files": [
    "llms.txt",
    "llms-full.txt",
    ".vcp/cards/"
  ],
  "cli": [
    "python3 -m vcp_cli evaluate --json",
    "python3 -m vcp_cli index show"
  ],
  "outputs": [
    "repository evaluation summary"
  ],
  "stop_conditions": [
    "manifests or benchmarks skipped"
  ],
  "validation": [
    "python3 -m vcp_cli manifest validate",
    "python3 -m vcp_cli benchmark run"
  ],
  "version": "v0.8.5",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "route",
    "evaluation"
  ]
}
