{
  "id": "public-site-readiness",
  "type": "route",
  "name": "Public Site Readiness",
  "summary": "Use when trust, docs, crawler readiness, and baseline public metadata need cleanup.",
  "use_when": [
    "public docs or site metadata need readiness work"
  ],
  "do_not_use_when": [
    "production app hardening is the real goal"
  ],
  "risk_level": "medium",
  "domains": [
    "public site"
  ],
  "maps_to": {
    "sdlc_phase": [
      "release",
      "growth"
    ],
    "ai_failure_modes": [
      "public growth without baseline"
    ],
    "project_state": [
      "public site"
    ],
    "risk_categories": [
      "public visibility"
    ]
  },
  "entry_files": [
    "docs/public-site-readiness.md",
    "llms.txt"
  ],
  "related_files": [
    "templates/public-site/README.md"
  ],
  "cli": [
    "python3 -m vcp_cli route --profile public-site"
  ],
  "outputs": [
    "public-site readiness recommendation"
  ],
  "stop_conditions": [
    "trust links or canonical docs are missing"
  ],
  "validation": [
    "python3 -m vcp_cli benchmark run --scenario public-site"
  ],
  "version": "v0.5.8"
}
