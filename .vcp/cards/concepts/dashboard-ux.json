      "review",
      "release"
    ],
    "ai_failure_modes": [
      "hosted-platform overclaim"
    ],
    "project_state": [
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "platform overclaim"
    ]
  },
  "entry_files": [
