    "someone wants platform-like control visibility without a hosted platform claim"
  ],
  "do_not_use_when": [
    "a hosted dashboard, cloud sync, or telemetry product is expected"
  ],
  "risk_level": "medium",
  "domains": [
    "concept",
    "local-tooling"
  ],
  "maps_to": {
