{
  "id": "public-evaluation-kit",
  "type": "concept",
  "name": "Public Evaluation Kit",
  "summary": "Minimum fair review kit for external evaluators.",
  "use_when": [
    "you need public evaluation kit as part of controlled AI delivery"
  ],
  "do_not_use_when": [
    "you need hosted, cloud, marketplace, or autonomous orchestration claims"
  ],
  "risk_level": "medium",
  "domains": [
    "evaluation",
    "proof"
  ],
  "maps_to": {
    "sdlc_phase": [
      "intake",
      "review"
    ],
    "ai_failure_modes": [
      "shallow external evaluation"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "evaluation integrity"
    ]
  },
  "entry_files": [
    "docs/public-evaluation-kit.md"
  ],
  "related_files": [
    "docs_ru/public-evaluation-kit.md",
    "PUBLIC_EVALUATION_KIT.md"
  ],
  "cli": [
    "python3 -m vcp_cli evaluator pack --json",
