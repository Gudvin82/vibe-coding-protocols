  "stop_conditions": [
    "do not call a README-only review full"
  ],
  "validation": [
    "python3 -m vcp_cli cards validate --json"
  ],
  "version": "v0.9.4",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
