{
  "id": "catalog",
  "type": "concept",
  "name": "Catalog UX",
  "summary": "Browse cards by filters, maturity, platform, and recommendation state.",
  "use_when": [
    "card discovery is getting noisy"
  ],
  "do_not_use_when": [
    "only one known card is needed"
  ],
  "risk_level": "low",
  "domains": [
    "concept",
    "catalog"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "review"
    ],
    "ai_failure_modes": [
      "discovery overload"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production",
      "public site"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "docs/catalog.md"
  ],
  "related_files": [
    ".vcp/catalog.json",
    "docs/vcp-cards.md"
  ],
  "cli": [
    "python3 -m vcp_cli cards list --recommended"
  ],
  "outputs": [
    "curated card discovery"
  ],
  "stop_conditions": [],
  "validation": [],
  "version": "v0.7.1",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "concept",
    "catalog"
  ]
}
