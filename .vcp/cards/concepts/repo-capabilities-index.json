{
  "id": "repo-capabilities-index",
  "type": "concept",
  "name": "Repo Capabilities Index",
  "summary": "Compact capability map that tells AI agents what VCP does and where the proof files live.",
  "use_when": [
    "a compact, easy-to-summarize capability map is needed before deeper inspection"
  ],
  "do_not_use_when": [
    "the evaluator needs a full audit instead of a compact index"
  ],
  "risk_level": "low",
  "domains": [
    "concept",
    "discovery"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "review"
    ],
    "ai_failure_modes": [
      "buried capabilities",
      "partial discovery"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "discovery friction"
    ]
  },
  "entry_files": [
    "REPO_CAPABILITIES_INDEX.md"
  ],
  "related_files": [
    "FULL_REPO_INTAKE.md",
    ".vcp/index.json"
  ],
  "cli": [
    "python3 -m vcp_cli evaluate --json"
  ],
  "outputs": [
    "capability-to-evidence map"
  ],
  "stop_conditions": [
    "do not use the index alone to claim full repository understanding"
  ],
  "validation": [
    "python3 -m vcp_cli evaluate --json"
  ],
  "version": "v0.9.1",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "concept",
    "index"
  ]
}
