{
  "id": "ai-intake-enforcement",
  "type": "concept",
  "name": "AI Intake Enforcement",
  "summary": "Repository-level guardrail that prevents README-only evaluation or blind whole-repo adoption.",
  "use_when": [
    "an AI agent is evaluating VCP itself",
    "a user shares the repo link and says take what is useful",
    "shallow README-only summaries must be prevented"
  ],
  "do_not_use_when": [
    "the agent already completed the required inspection path and is working inside a target project"
  ],
  "risk_level": "medium",
  "domains": [
    "concept",
    "intake"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "intake"
    ],
    "ai_failure_modes": [
      "README-only evaluation",
      "whole-repo copy recommendation"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "shallow evaluation",
      "adoption drift"
    ]
  },
  "entry_files": [
    "AGENTS.md",
    "TAKE_THIS_FIRST.md",
    "AI_INTAKE.md",
    ".vcp/index.json"
  ],
  "related_files": [
    "docs/flagship-workflows.md",
    "docs/product-delivery-lifecycle.md",
    "templates/prompts/adopt-vcp-from-link.md"
  ],
  "cli": [
    "python3 -m vcp_cli evaluate --json",
    "python3 -m vcp_cli index validate",
    "python3 -m vcp_cli cards list --recommended",
    "python3 -m vcp_cli diagnose --json"
  ],
  "outputs": [
    "full vs shallow evaluation boundary",
    "adoption-from-link route decision"
  ],
  "stop_conditions": [
    "README-only evaluation is being presented as full",
    "the answer recommends copying the whole repository"
  ],
  "validation": [
    "cards validate",
    "index validate",
    "benchmark run"
  ],
  "version": "v0.6.3",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot",
    "gemini-cli"
  ],
  "badges": [
    "concept",
    "intake",
    "recommended"
  ]
}
