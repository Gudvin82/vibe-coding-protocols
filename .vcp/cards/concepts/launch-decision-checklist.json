{
  "id": "launch-decision-checklist",
  "type": "concept",
  "name": "Launch Decision Checklist",
  "summary": "Local review aid for go / go-with-warnings / no-go / needs-human-review decisions after route, proof, and PR Gate review.",
  "use_when": [
    "a team needs a bounded local launch decision artifact for an existing MVP"
  ],
  "do_not_use_when": [
    "production certification or deployment automation is expected"
  ],
  "risk_level": "high",
  "domains": [
    "concept",
    "launch-control"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review",
      "release"
    ],
    "ai_failure_modes": [
      "premature launch",
      "overclaim"
    ],
    "project_state": [
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "launch readiness"
    ]
  },
  "entry_files": [
    "docs/launch-decision-checklist.md",
    "templates/reports/launch-decision.md"
  ],
  "related_files": [
    "docs/mvp-to-launch-path.md",
    "docs/pr-gate-approval-model.md"
  ],
  "cli": [
    "python3 -m vcp_cli pr-gate explain --json",
    "python3 -m vcp_cli release-check --json"
  ],
  "outputs": [
    "local launch decision report"
  ],
  "stop_conditions": [
    "do not describe this as production certification"
  ],
  "validation": [
    "templates/reports/launch-decision.md exists"
  ],
  "version": "v0.9.1",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf"
  ],
  "badges": [
    "concept",
    "launch"
  ]
}
