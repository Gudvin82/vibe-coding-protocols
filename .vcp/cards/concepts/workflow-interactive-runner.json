{
  "id": "workflow-interactive-runner",
  "type": "concept",
  "name": "Workflow Interactive Runner",
  "summary": "Safe preview mode for workflow JSON that requires interactivity and never becomes a hidden automation engine.",
  "use_when": [
    "workflow steps need an interactive preview surface"
  ],
  "do_not_use_when": [
    "deployment or file-mutation automation is expected"
  ],
  "risk_level": "medium",
  "domains": [
    "concept",
    "workflow"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "review"
    ],
    "ai_failure_modes": [
      "workflow confusion"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "tooling clarity"
    ]
  },
  "entry_files": [
    "vcp_cli/workflow_cmd.py",
    "docs/workflows.md"
  ],
  "related_files": [
    ".vcp/workflows/production-hardening.json"
  ],
  "cli": [
    "python3 -m vcp_cli workflow run --id production-hardening --interactive --dry-run --json"
  ],
  "outputs": [
    "safe preview step summary"
  ],
  "stop_conditions": [
    "do not execute external actions or access secrets"
  ],
  "validation": [
    "python3 -m vcp_cli workflow plan --id production-hardening --json"
  ],
  "version": "v0.8.3",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "concept",
    "workflow",
    "safe"
  ]
}
