  "use_when": [
    "first-contact understanding needs review",
    "README and onboarding surfaces are being polished"
  ],
  "do_not_use_when": [
    "a full technical audit is being replaced by a first-impression check"
  ],
  "risk_level": "medium",
  "domains": [
    "concept",
    "audit"
  ],
  "maps_to": {
    "sdlc_phase": [
      "intake",
      "planning"
    ],
    "ai_failure_modes": [
      "shallow evaluation",
      "misclassification"
    ],
    "project_state": [
      "new"
    ],
    "risk_categories": [
      "adoption trust"
    ]
  },
  "entry_files": [
