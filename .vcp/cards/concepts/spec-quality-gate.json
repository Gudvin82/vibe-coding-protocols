{
  "id": "spec-quality-gate",
  "type": "concept",
  "name": "Spec Quality Gate",
  "summary": "Lightweight check that core spec-foundation artifacts exist before AI implementation expands.",
  "use_when": [
    "a new project or major feature needs a lightweight readiness check before implementation"
  ],
  "do_not_use_when": [
    "the task is already a tiny validated no-spec change"
  ],
  "risk_level": "medium",
  "domains": [
    "concept",
    "spec-driven-delivery"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning"
    ],
    "ai_failure_modes": [
      "scope gaps",
      "hidden validation gaps"
    ],
    "project_state": [
      "new",
      "existing MVP"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "docs/spec-quality-gate.md",
    "templates/reports/spec-quality-gate-report.md"
  ],
  "related_files": [
    "templates/specs/PRODUCT_BRIEF.md",
    "templates/specs/SPEC_TO_BACKLOG.md"
  ],
  "cli": [
    "python3 -m vcp_cli spec quality-gate --json"
  ],
  "outputs": [
    "pass/warn/block spec foundation signal"
  ],
  "stop_conditions": [
    "do not expand implementation while core scope artifacts are still missing"
  ],
  "validation": [
    "python3 -m vcp_cli spec quality-gate --json"
  ],
  "version": "v0.9.0",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "concept",
    "quality-gate"
  ]
}
