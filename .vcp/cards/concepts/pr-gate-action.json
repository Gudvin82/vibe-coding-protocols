{
  "id": "pr-gate-action",
  "type": "concept",
  "name": "PR Gate Action",
  "summary": "Pinned GitHub Actions workflow template for adding VCP decision support to pull requests.",
  "use_when": [
    "a repository needs VCP in pull request review flow"
  ],
  "do_not_use_when": [
    "security certification language is expected"
  ],
  "risk_level": "medium",
  "domains": [
    "concept",
    "ci"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "certification overclaim"
    ],
    "project_state": [
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "release clarity"
    ]
  },
  "entry_files": [
    "docs/pr-gate.md",
    "docs/pr-gate-action.md",
    "ci-examples/github-actions/vcp-pr-gate.yml"
  ],
  "related_files": [
    "docs/github-action.md"
  ],
  "cli": [
    "vcp review-diff --json",
    "vcp release-check --json"
  ],
  "outputs": [
    "PR decision workflow template"
  ],
  "stop_conditions": [
    "PR Gate is decision support, not certification"
  ],
  "validation": [
    "ci-examples/github-actions/vcp-pr-gate.yml exists"
  ],
  "version": "v0.8.7",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "github-copilot",
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf"
  ],
  "badges": [
    "concept",
    "ci",
    "review"
  ]
}
