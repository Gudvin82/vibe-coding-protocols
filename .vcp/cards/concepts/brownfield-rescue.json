{
  "id": "brownfield-rescue-concept",
  "type": "concept",
  "name": "Brownfield Rescue",
  "summary": "Focused VCP path for existing repositories with weak control, hidden backlog, or AI-generated architecture drift.",
  "use_when": [
    "existing repository control debt is already visible"
  ],
  "do_not_use_when": [
    "there is no repository yet and the work is still greenfield"
  ],
  "risk_level": "high",
  "domains": [
    "concept",
    "hardening"
  ],
  "maps_to": {
    "sdlc_phase": [
      "implementation",
      "review",
      "release"
    ],
    "ai_failure_modes": [
      "drift",
      "release confusion",
      "hidden backlog"
    ],
    "project_state": [
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "delivery chaos"
    ]
  },
  "entry_files": [
    "docs/adoption-packs.md",
    "docs/walkthroughs/ai-mvp-hardening.md"
  ],
  "related_files": [
    "templates/reports/brownfield-rescue-report.md",
    "docs/architecture-drift.md"
  ],
  "cli": [
    "python3 -m vcp_cli diagnose --json"
  ],
  "outputs": [
    "brownfield control plan"
  ],
  "stop_conditions": [
    "do not keep shipping features while control debt is still hidden"
  ],
  "validation": [
    "python3 -m vcp_cli release-check --json"
  ],
  "version": "v0.8.7",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "concept",
    "brownfield"
  ]
}
