{
  "id": "release-readiness",
  "type": "concept",
  "name": "Release Readiness",
  "summary": "Pass/warn/block control surface before a repository slice is called ready for release.",
  "use_when": [
    "release pressure exists and the team needs one visible pre-tag decision point"
  ],
  "do_not_use_when": [
    "the change is still at idea stage with no implementation or diff"
  ],
  "risk_level": "high",
  "domains": [
    "concept",
    "release"
  ],
  "maps_to": {
    "sdlc_phase": [
      "release"
    ],
    "ai_failure_modes": [
      "release without validation",
      "stale architecture memory"
    ],
    "project_state": [
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "delivery chaos",
      "security"
    ]
  },
  "entry_files": [
    "docs/release-readiness.md",
    "templates/reports/release-readiness-report.md"
  ],
  "related_files": [
    "docs/pr-gate.md",
    "docs/public-source-of-truth-audit.md",
    "docs/architecture-drift.md"
  ],
  "cli": [
    "python3 -m vcp_cli release-check --json"
  ],
  "outputs": [
    "pass/warn/block release signal"
  ],
  "stop_conditions": [
    "do not tag when version surfaces, validation, or release notes are still broken"
  ],
  "validation": [
    "python3 -m vcp_cli release-check --json"
  ],
  "version": "v0.8.7",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "concept",
    "release"
  ]
}
