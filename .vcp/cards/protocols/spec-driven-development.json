{
  "id": "spec-driven-development",
  "type": "protocol",
  "name": "Spec-driven Development",
  "summary": "First-class VCP lane for idea → PRD → feature spec → tasks → review.",
  "use_when": [
    "non-trivial feature planning",
    "founder brief needs structure"
  ],
  "do_not_use_when": [
    "emergency hotfix",
    "tiny mechanical change"
  ],
  "risk_level": "medium",
  "domains": [
    "spec-driven-delivery"
  ],
  "maps_to": {
    "sdlc_phase": [
      "idea",
      "planning"
    ],
    "ai_failure_modes": [
      "no product brief",
      "unclear acceptance"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "delivery chaos",
      "scope drift"
    ]
  },
  "entry_files": [
    "protocols/spec-driven/README.md"
  ],
  "related_files": [
    "templates/specs/PRD.md",
    "templates/specs/FEATURE_SPEC.md"
  ],
  "cli": [
    "python3 -m vcp_cli spec summary --json"
  ],
  "outputs": [
    "spec lane guidance"
  ],
  "stop_conditions": [],
  "validation": [
    "python3 -m vcp_cli spec validate"
  ],
  "version": "v0.9.2",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "protocol",
    "spec"
  ]
}
