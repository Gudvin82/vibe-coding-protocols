{
  "id": "vcp-onboard",
  "type": "command",
  "name": "Onboard",
  "summary": "Prints the next practical VCP commands for the current project context.",
  "use_when": [
    "a new user needs a first practical step"
  ],
  "do_not_use_when": [
    "deep repo evaluation is already complete"
  ],
  "risk_level": "low",
  "domains": [
    "cli",
    "onboarding"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning"
    ],
    "ai_failure_modes": [
      "entrypoint confusion"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "tooling clarity"
    ]
  },
  "entry_files": [
    "vcp_cli/onboard.py"
  ],
  "related_files": [
    "README.md",
    "docs/cli.md"
  ],
  "cli": [
    "python3 -m vcp_cli onboard --json"
  ],
  "outputs": [
    "recommended track, tier, and next commands"
  ],
  "stop_conditions": [],
  "validation": [
    "python3 -m vcp_cli onboard --json"
  ],
  "version": "v0.8.6",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "onboarding"
  ]
}
