{
  "id": "vcp-diagnose",
  "type": "command",
  "name": "Diagnose",
  "summary": "Layer-by-layer readiness checks for project/process health.",
  "use_when": [
    "process readiness is unclear"
  ],
  "do_not_use_when": [
    "only environment/tooling health is needed"
  ],
  "risk_level": "low",
  "domains": [
    "cli",
    "diagnostics"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "review",
      "release"
    ],
    "ai_failure_modes": [
      "missing process layer"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production",
      "public site"
    ],
    "risk_categories": [
      "delivery chaos",
      "release risk"
    ]
  },
  "entry_files": [
    "vcp_cli/diagnose.py"
  ],
  "related_files": [
    "docs/diagnostics.md",
    ".vcp/diagnostics/layers.json"
  ],
  "cli": [
    "python3 -m vcp_cli diagnose --json"
  ],
  "outputs": [
    "layer-by-layer readiness report"
  ],
  "stop_conditions": [],
  "validation": [
    "python3 -m vcp_cli --help"
  ],
  "version": "v0.8.6",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "diagnostics"
  ]
}
