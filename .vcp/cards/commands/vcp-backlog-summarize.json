{
  "id": "vcp-backlog-summarize",
  "type": "command",
  "name": "Backlog Summarize",
  "summary": "Summarize the audit backlog distribution, including stale and resolved items.",
  "use_when": [
    "findings need a quick governance summary"
  ],
  "do_not_use_when": [
    "the command is expected to mutate backlog state"
  ],
  "risk_level": "low",
  "domains": [
    "cli",
    "review"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "finding drift"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "auditability"
    ]
  },
  "entry_files": [
    "vcp_cli/backlog.py"
  ],
  "related_files": [
    "docs/audit-backlog.md"
  ],
  "cli": [
    "python3 -m vcp_cli backlog summarize .vcp/audit-backlog.example.json --json"
  ],
  "outputs": [
    "audit backlog summary"
  ],
  "stop_conditions": [
    "no mutation unless explicit future commands are added"
  ],
  "validation": [
    "python3 -m vcp_cli backlog summarize .vcp/audit-backlog.example.json --json"
  ],
  "version": "v0.9.3",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "local",
    "audit"
  ]
}
