{
  "id": "vcp-audit-plan",
  "type": "command",
  "name": "Audit Plan",
  "summary": "Prints the required file set, evaluation modes, and failure contract for AI agents auditing VCP.",
  "use_when": [
    "an AI agent needs the required audit path before calling a review full"
  ],
  "do_not_use_when": [
    "the answer pretends the manifest is optional"
  ],
  "risk_level": "low",
  "domains": [
    "cli",
    "audit"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "review"
    ],
    "ai_failure_modes": [
      "summary inflation",
      "inspection gaps"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "trust gap"
    ]
  },
  "entry_files": [
    "vcp_cli/audit_plan.py"
  ],
  "related_files": [
    ".vcp/ai-audit-manifest.json",
    "FULL_REPO_INTAKE.md",
    "AI_FULL_REPO_AUDIT.md"
  ],
  "cli": [
    "python3 -m vcp_cli audit-plan --json"
  ],
  "outputs": [
    "required audit path and failure contract"
  ],
  "stop_conditions": [
    "do not call a shallow or partial review full"
  ],
  "validation": [
    "python3 -m vcp_cli audit-plan --json"
  ],
  "version": "v0.7.1",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "audit"
  ]
}
