{
  "id": "vcp-integrations-list",
  "type": "command",
  "name": "Integrations List",
  "summary": "List local integration registry entries and optional status-filtered subsets without network or install behavior.",
  "use_when": [
    "a local control/report command is needed"
  ],
  "do_not_use_when": [
    "a hosted or remote service is expected"
  ],
  "risk_level": "medium",
  "domains": [
    "cli"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "overclaim"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "tooling clarity"
    ]
  },
  "entry_files": [
    "vcp_cli/integrations_cmd.py"
  ],
  "related_files": [
    "docs/integrations/status-model.md",
    "docs/cli.md"
  ],
  "cli": [
    "python3 -m vcp_cli integrations list --json"
  ],
  "outputs": [
    "local integration registry view"
  ],
  "stop_conditions": [
    "status filter is limited to declared statuses"
  ],
  "validation": [
    "python3 -m vcp_cli integrations list --json"
  ],
  "version": "v0.9.5",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "local"
  ]
}
