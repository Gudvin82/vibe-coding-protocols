{
  "id": "vcp-metrics-board",
  "type": "command",
  "name": "Metrics Board",
  "summary": "Show local counts and readiness signals without claiming objective truth or hosted observability.",
  "use_when": [
    "local metrics or backlog visualization is needed"
  ],
  "do_not_use_when": [
    "hosted analytics or launch guarantees are expected"
  ],
  "risk_level": "low",
  "domains": [
    "cli",
    "metrics"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "metrics overclaim"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "tooling clarity"
    ]
  },
  "entry_files": [
    "vcp_cli/metrics_cmd.py"
  ],
  "related_files": [
    "docs/metrics-board.md",
    "docs/audit-backlog-visualization.md"
  ],
  "cli": [
    "python3 -m vcp_cli metrics board --json"
  ],
  "outputs": [
    "local metrics summary"
  ],
  "stop_conditions": [
    "no objective-truth claim",
    "no hosted board"
  ],
  "validation": [
    "python3 -m vcp_cli metrics board --json"
  ],
  "version": "v0.8.8",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
