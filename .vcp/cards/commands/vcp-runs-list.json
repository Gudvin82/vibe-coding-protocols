{
  "id": "vcp-runs-list",
  "type": "command",
  "name": "Runs List",
  "summary": "List local run-state artifacts for resumable, auditable evaluations.",
  "use_when": [
    "long or repeated evaluations need an explicit run-state view"
  ],
  "do_not_use_when": [
    "background scheduler behavior is expected"
  ],
  "risk_level": "low",
  "domains": [
    "cli",
    "governance"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "lost state"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "auditability"
    ]
  },
  "entry_files": [
    "vcp_cli/runs_cmd.py"
  ],
  "related_files": [
    "docs/run-state.md"
  ],
  "cli": [
    "python3 -m vcp_cli runs list --json"
  ],
  "outputs": [
    "run state list"
  ],
  "stop_conditions": [
    "read-only unless a user explicitly creates run files elsewhere"
  ],
  "validation": [
    "python3 -m vcp_cli runs list --json"
  ],
  "version": "v0.8.7",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "local",
    "audit"
  ]
}
