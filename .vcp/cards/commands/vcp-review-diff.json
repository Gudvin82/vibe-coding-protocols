{
  "id": "vcp-review-diff",
  "type": "command",
  "name": "Review Diff",
  "summary": "Local pre-merge trust gate for changed files.",
  "use_when": [
    "AI-generated changes need a merge or release decision."
  ],
  "do_not_use_when": [
    "there is no diff to inspect and no repo change context."
  ],
  "risk_level": "medium",
  "domains": [
    "cli",
    "review"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "merge without diff understanding"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "delivery chaos",
      "release risk"
    ]
  },
  "entry_files": [
    "vcp_cli/review_diff.py"
  ],
  "related_files": [
    "docs/review-diff.md",
    "templates/reports/review-diff-report.md"
  ],
  "cli": [
    "python3 -m vcp_cli review-diff --json"
  ],
  "outputs": [
    "risk level",
    "spec depth recommendation",
    "artifact follow-up"
  ],
  "stop_conditions": [
    "do not auto-approve or auto-edit the diff"
  ],
  "validation": [
    "python3 -m vcp_cli review-diff --json"
  ],
  "version": "v0.8.0",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "review"
  ]
}
