{
  "id": "vcp-runs-validate",
  "type": "command",
  "name": "Runs Validate",
  "summary": "Validate a local run-state JSON file against the expected checkpoint model.",
  "use_when": [
    "run artifacts need schema validation"
  ],
  "do_not_use_when": [
    "remote scheduler guarantees are expected"
  ],
  "risk_level": "low",
  "domains": [
    "cli",
    "governance"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "schema drift"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "auditability"
    ]
  },
  "entry_files": [
    "vcp_cli/runs_cmd.py"
  ],
  "related_files": [
    "docs/run-state.md"
  ],
  "cli": [
    "python3 -m vcp_cli runs validate .vcp/runs/example-run-state.json --json"
  ],
  "outputs": [
    "run state validation result"
  ],
  "stop_conditions": [
    "validation is local and deterministic"
  ],
  "validation": [
    "python3 -m vcp_cli runs validate .vcp/runs/example-run-state.json --json"
  ],
  "version": "v0.9.4",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "local",
    "audit"
  ]
}
