{
  "id": "vcp-plugins-validate",
  "type": "command",
  "name": "Plugins Validate",
  "summary": "Validate local plugin metadata shape and safety flags without importing or executing plugin code.",
  "use_when": [
    "plugin metadata needs a safe local validation pass"
  ],
  "do_not_use_when": [
    "plugin execution is expected"
  ],
  "risk_level": "medium",
  "domains": [
    "cli",
    "plugins"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "plugin overclaim"
    ],
    "project_state": [
      "new",
      "existing MVP"
    ],
    "risk_categories": [
      "tooling clarity"
    ]
  },
  "entry_files": [
    "vcp_cli/plugins_cmd.py"
  ],
  "related_files": [
    "docs/plugins/plugin-contract-draft.md",
    "docs/plugins/plugin-safety.md"
  ],
  "cli": [
    "python3 -m vcp_cli plugins validate examples/plugins/example-readiness-check.plugin.json --json"
  ],
  "outputs": [
    "plugin metadata validation result"
  ],
  "stop_conditions": [
    "no execution",
    "no network"
  ],
  "validation": [
    "python3 -m vcp_cli plugins validate examples/plugins/example-readiness-check.plugin.json --json"
  ],
  "version": "v0.9.5",
  "maturity": "experimental",
  "recommended": true,
  "platforms": [
