{
  "id": "vcp-classify",
  "type": "command",
  "name": "Classify",
  "summary": "Classifies the current repository by track, risk, tier, and suggested route.",
  "use_when": [
    "adoption should start with project classification"
  ],
  "do_not_use_when": [
    "classification is being replaced by gut feel"
  ],
  "risk_level": "low",
  "domains": [
    "cli",
    "classification"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning"
    ],
    "ai_failure_modes": [
      "route confusion"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "tooling clarity"
    ]
  },
  "entry_files": [
    "vcp_cli/classify.py"
  ],
  "related_files": [
    "docs/adoption-tiers.md",
    "docs/two-track-model.md"
  ],
  "cli": [
    "python3 -m vcp_cli classify --json"
  ],
  "outputs": [
    "project type, track, tier, route"
  ],
  "stop_conditions": [],
  "validation": [
    "python3 -m vcp_cli classify --json"
  ],
  "version": "v0.9.4",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "classification"
  ]
}
