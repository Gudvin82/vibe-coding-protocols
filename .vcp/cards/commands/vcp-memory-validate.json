{
  "id": "vcp-memory-validate",
  "type": "command",
  "name": "Memory Validate",
  "summary": "Validate project-memory JSON against the expected local governance shape.",
  "use_when": [
    "project memory must be checked before review or release"
  ],
  "do_not_use_when": [
    "a remote registry or sync service is expected"
  ],
  "risk_level": "low",
  "domains": [
    "cli",
    "governance"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "schema drift"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "governance drift"
    ]
  },
  "entry_files": [
    "vcp_cli/memory_cmd.py"
  ],
  "related_files": [
    "docs/project-memory.md"
  ],
  "cli": [
    "python3 -m vcp_cli memory validate .vcp/project-memory.example.json --json"
  ],
  "outputs": [
    "memory validation result"
  ],
  "stop_conditions": [
    "validation is local and deterministic only"
  ],
  "validation": [
    "python3 -m vcp_cli memory validate .vcp/project-memory.example.json --json"
  ],
  "version": "v0.8.3",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "local",
    "governance"
  ]
}
