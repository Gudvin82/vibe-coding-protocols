{
  "id": "score-badge",
  "type": "command",
  "name": "Score Badge",
  "summary": "Generate a local VCP readiness badge string without claiming certification.",
  "use_when": [
    "a repo wants a visible local readiness signal after checks pass"
  ],
  "do_not_use_when": [
    "someone would mistake the badge for external certification"
  ],
  "risk_level": "low",
  "domains": [
    "cli",
    "release"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review",
      "release"
    ],
    "ai_failure_modes": [
      "proof overclaim"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "public trust"
    ]
  },
  "entry_files": [
    "vcp_cli/score.py"
  ],
  "related_files": [
    "docs/score-badge.md",
    "templates/reports/score-badge-report.md"
  ],
  "cli": [
    "python3 -m vcp_cli score --badge markdown"
  ],
  "outputs": [
    "badge markdown",
    "badge json",
    "local readiness note"
  ],
  "stop_conditions": [
    "do not present the badge as certification"
  ],
  "validation": [
    "python3 -m vcp_cli score --badge json"
  ],
  "version": "v0.6.6",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "release"
  ]
}
