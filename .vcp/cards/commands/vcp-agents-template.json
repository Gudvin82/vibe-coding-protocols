{
  "id": "vcp-agents-template",
  "type": "command",
  "name": "Agents Template",
  "summary": "Show or write copyable instruction templates for supported coding agents.",
  "use_when": [
    "a repository wants a minimal, explicit AI agent rules file"
  ],
  "do_not_use_when": [
    "hosted agent orchestration is expected"
  ],
  "risk_level": "medium",
  "domains": [
    "cli",
    "governance"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "review"
    ],
    "ai_failure_modes": [
      "overclaim"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "agent control"
    ]
  },
  "entry_files": [
    "vcp_cli/agent_templates_cmd.py"
  ],
  "related_files": [
    "docs/agent-instructions.md",
    "templates/agents/CODEX.md"
  ],
  "cli": [
    "python3 -m vcp_cli agents template --agent codex --json"
  ],
  "outputs": [
    "copyable agent instruction template"
  ],
  "stop_conditions": [
    "overwrite requires --confirm when writing to disk"
  ],
  "validation": [
    "python3 -m vcp_cli agents template --agent codex --json"
  ],
  "version": "v0.9.2",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "local",
    "agent-control"
  ]
}
