{
  "id": "vcp-public-growth-check",
  "type": "command",
  "name": "Public Growth Check",
  "summary": "Checks local public-growth readiness signals without promising outcomes.",
  "use_when": [
    "public growth work needs structured evidence"
  ],
  "do_not_use_when": [
    "ranking guarantees are being implied"
  ],
  "risk_level": "medium",
  "domains": [
    "cli",
    "public-growth"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "marketing overclaim"
    ],
    "project_state": [
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "trust gap"
    ]
  },
  "entry_files": [
    "vcp_cli/public_growth.py"
  ],
  "related_files": [
    "docs/public-growth/geo-checks.md"
  ],
  "cli": [
    "python3 -m vcp_cli public-growth check --json"
  ],
  "outputs": [
    "public growth readiness summary"
  ],
  "stop_conditions": [
    "do not promise ranking or AI citation outcomes"
  ],
  "validation": [
    "python3 -m vcp_cli public-growth check --json"
  ],
  "version": "v0.8.6",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "public-growth"
  ]
}
