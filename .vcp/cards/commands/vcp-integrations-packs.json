{
  "id": "vcp-integrations-packs",
  "type": "command",
  "name": "Integration Packs List",
  "summary": "List local integration-pack registry entries without installs, network calls, or marketplace behavior.",
  "use_when": [
    "a local integration-pack overview is needed"
  ],
  "do_not_use_when": [
    "an official remote integration or marketplace action is expected"
  ],
  "risk_level": "medium",
  "domains": [
    "cli"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "overclaim"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "tooling clarity"
    ]
  },
  "entry_files": [
    "vcp_cli/integrations_cmd.py"
  ],
  "related_files": [
    "docs/integration-packs.md",
    ".vcp/integration-packs.json"
  ],
  "cli": [
    "python3 -m vcp_cli integrations packs --json"
  ],
  "outputs": [
    "local integration pack registry view"
  ],
  "stop_conditions": [
    "status filter is limited to declared statuses"
  ],
  "validation": [
    "python3 -m vcp_cli integrations packs --json"
  ],
  "version": "v0.8.9",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "local"
  ]
}
