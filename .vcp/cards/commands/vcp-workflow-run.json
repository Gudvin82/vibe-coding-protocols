{
  "id": "vcp-workflow-run",
  "type": "command",
  "name": "Workflow Run",
  "summary": "Interactive safe runner/planner for workflow JSON that previews steps without executing external actions.",
  "use_when": [
    "workflow steps need an interactive preview"
  ],
  "do_not_use_when": [
    "hidden automation engine behavior is expected"
  ],
  "risk_level": "medium",
  "domains": [
    "cli",
    "workflow"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "review"
    ],
    "ai_failure_modes": [
      "workflow confusion"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "tooling clarity"
    ]
  },
  "entry_files": [
    "vcp_cli/workflow_cmd.py"
  ],
  "related_files": [
    "docs/workflows.md"
  ],
  "cli": [
    "python3 -m vcp_cli workflow run --id production-hardening --interactive --dry-run --json"
  ],
  "outputs": [
    "interactive workflow preview"
  ],
  "stop_conditions": [
    "requires --interactive",
    "never deploys or modifies files"
  ],
  "validation": [
    "python3 -m vcp_cli workflow run --id production-hardening --interactive --dry-run --json"
  ],
  "version": "v0.9.4",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "workflow",
    "safe"
  ]
}
