{
  "id": "vcp-agent-behavior-check",
  "type": "command",
  "name": "Agent Behavior Check",
  "summary": "Run a heuristic local text check against an agent report.",
  "use_when": [
    "a local control/report command is needed"
  ],
  "do_not_use_when": [
    "a hosted or remote service is expected"
  ],
  "risk_level": "medium",
  "domains": [
    "cli"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "overclaim"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "tooling clarity"
    ]
  },
  "entry_files": [
    "vcp_cli/agent_behavior_cmd.py"
  ],
  "related_files": [
    "docs/agent-behavior-gate.md"
  ],
  "cli": [
    "python3 -m vcp_cli agent-behavior check --report tests/fixtures/agent-report.md --json"
  ],
  "outputs": [
    "local heuristic behavior result"
  ],
  "stop_conditions": [
    "heuristic only"
  ],
  "validation": [
    "python3 -m vcp_cli agent-behavior check --report tests/fixtures/agent-report.md --json"
  ],
  "version": "v0.8.3",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "local"
  ]
}
