{
  "id": "vcp-batch-evaluate",
  "type": "command",
  "name": "Batch Evaluate",
  "summary": "Evaluate multiple local targets and return per-target results plus an aggregate summary.",
  "use_when": [
    "a local control/report command is needed"
  ],
  "do_not_use_when": [
    "a hosted or remote service is expected"
  ],
  "risk_level": "medium",
  "domains": [
    "cli"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "overclaim"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "tooling clarity"
    ]
  },
  "entry_files": [
    "vcp_cli/batch_cmd.py"
  ],
  "related_files": [
    "docs/batch-evaluation.md"
  ],
  "cli": [
    "python3 -m vcp_cli batch evaluate --targets /tmp/vcp-targets.txt --json"
  ],
  "outputs": [
    "multi-target local evaluation summary"
  ],
  "stop_conditions": [
    "no network, no mutation"
  ],
  "validation": [
    "python3 -m vcp_cli batch evaluate --targets /tmp/vcp-targets.txt --json"
  ],
  "version": "v0.9.5",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "local"
  ]
}
