{
  "id": "vcp-adopt-apply",
  "type": "command",
  "name": "Adopt Apply",
  "summary": "Explicit safe apply for adoption packs with target, confirm, dry-run, conflicts, and adoption log output.",
  "use_when": [
    "approved pack files should be copied safely into a target project"
  ],
  "do_not_use_when": [
    "destructive overwrite is expected"
  ],
  "risk_level": "high",
  "domains": [
    "cli",
    "adoption"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "blind copying"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "change safety"
    ]
  },
  "entry_files": [
    "vcp_cli/adopt.py"
  ],
  "related_files": [
    "docs/adoption-packs.md",
    "docs/protocol-pack-security.md"
  ],
  "cli": [
    "python3 -m vcp_cli adopt apply --pack brownfield-rescue --target ./target-project --dry-run --json"
  ],
  "outputs": [
    "apply summary",
    "adoption log"
  ],
  "stop_conditions": [
    "confirm required for writes",
    "do not overwrite existing files by default"
  ],
  "validation": [
    "python3 -m vcp_cli adopt apply --pack brownfield-rescue --target /tmp/vcp-adopt-test --dry-run --json"
  ],
  "version": "v0.9.3",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "claude-code",
    "codex-cli",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "adoption",
    "safe"
  ]
}
