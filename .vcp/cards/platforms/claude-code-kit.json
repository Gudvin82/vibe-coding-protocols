{
  "id": "claude-code-kit",
  "type": "platform",
  "name": "Claude Code Kit",
  "summary": "Copy-ready Claude Code adoption kit for VCP.",
  "use_when": ["Claude Code is the active repository coding tool"],
  "do_not_use_when": ["official plugin support is required"],
  "risk_level": "low",
  "domains": ["platform-compatibility", "ai-tooling"],
  "maps_to": {
    "sdlc_phase": ["intake", "implementation", "review"],
    "ai_failure_modes": ["broad rewrite", "unclear route"],
    "project_state": ["new-project", "existing-repo"],
    "risk_categories": ["adoption scope", "rules drift"]
  },
  "entry_files": ["docs/integrations/agent-kits.md", "templates/agent-kits/claude/README.md"],
  "related_files": ["templates/agent-kits/claude/CLAUDE.md", ".vcp/agent-kits.json"],
  "cli": ["python3 -m vcp_cli agents kit --target claude --json"],
  "outputs": ["Claude Code setup bundle"],
  "stop_conditions": ["do not call this an official plugin"],
  "validation": ["python3 -m vcp_cli agents kit --target claude --json"],
  "version": "v0.9.2",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": ["claude-code"],
  "badges": ["kit"]
}
