{
  "id": "copilot-kit",
  "type": "platform",
  "name": "GitHub Copilot Kit",
  "summary": "Copy-ready GitHub Copilot adoption kit for VCP.",
  "use_when": ["GitHub Copilot is the active repository coding tool"],
  "do_not_use_when": ["official plugin support is required"],
  "risk_level": "low",
  "domains": ["platform-compatibility", "ai-tooling"],
  "maps_to": {
    "sdlc_phase": ["intake", "implementation", "review"],
    "ai_failure_modes": ["README-only guidance", "prompt-only overclaim"],
    "project_state": ["new-project", "existing-repo"],
    "risk_categories": ["adoption scope", "rules drift"]
  },
  "entry_files": ["docs/integrations/agent-kits.md", "templates/agent-kits/copilot/README.md"],
  "related_files": ["templates/agent-kits/copilot/copilot-instructions.md", ".vcp/agent-kits.json"],
  "cli": ["python3 -m vcp_cli agents kit --target copilot --json"],
  "outputs": ["GitHub Copilot setup bundle"],
  "stop_conditions": ["do not call this an official plugin"],
  "validation": ["python3 -m vcp_cli agents template --agent copilot --json"],
  "version": "v0.9.5",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": ["github-copilot"],
  "badges": ["kit"]
}
