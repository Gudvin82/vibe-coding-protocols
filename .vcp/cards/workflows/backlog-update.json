{
  "id": "workflow-backlog-update",
  "type": "workflow",
  "name": "Backlog Update Workflow",
  "summary": "Workflow card for Backlog Update Workflow.",
  "use_when": [
    "Work or findings must be made durable outside chat history."
  ],
  "do_not_use_when": [
    "you expect the workflow file to execute automation by itself"
  ],
  "risk_level": "medium",
  "domains": [
    "workflow",
    "delivery-governance"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "implementation",
      "review"
    ],
    "ai_failure_modes": [
      "chat-only memory",
      "skipped validation"
    ],
    "project_state": [
      "new-project",
      "existing-repo"
    ],
    "risk_categories": [
      "route drift",
      "validation drift"
    ]
  },
  "entry_files": [
    ".vcp/workflows/backlog-update.json"
  ],
  "related_files": [
    "docs/workflows.md"
  ],
  "cli": [
    "python3 -m vcp_cli workflow show backlog-update"
  ],
  "outputs": [
    "backlog update",
    "next step"
  ],
  "stop_conditions": [
    "Cross-layer architecture impact is not documented",
    "Backlog transition would bypass review discipline"
  ],
  "validation": [
    "python3 -m vcp_cli backlog validate"
  ],
  "version": "v0.7.0",
  "maturity": "stable",
  "recommended": false,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor"
  ],
  "badges": [
    "workflow"
  ]
}
