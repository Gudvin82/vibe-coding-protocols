{
  "id": "workflow-mvp-to-launch",
  "type": "workflow",
  "name": "MVP-to-Launch Workflow",
  "summary": "Workflow card for the guided MVP-to-Launch planning path under Existing Project Track.",
  "use_when": [
    "an AI-generated MVP already exists and needs launch-control planning before demo, PR, or release"
  ],
  "do_not_use_when": [
    "the user expects hidden execution, deploy, or publish behavior"
  ],
  "risk_level": "high",
  "domains": [
    "workflow",
    "launch-control"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review",
      "release"
    ],
    "ai_failure_modes": [
      "premature launch",
      "hidden control gap"
    ],
    "project_state": [
      "existing MVP"
    ],
    "risk_categories": [
      "launch readiness"
    ]
  },
  "entry_files": [
    ".vcp/workflows/mvp-to-launch.json"
  ],
  "related_files": [
    "docs/mvp-to-launch-path.md",
    "docs/workflows.md",
    "docs/launch-decision-checklist.md"
  ],
  "cli": [
    "python3 -m vcp_cli workflow plan --id mvp-to-launch --json"
  ],
  "outputs": [
    "deterministic workflow plan"
  ],
  "stop_conditions": [
    "workflow JSON is planning metadata only"
  ],
  "validation": [
    "python3 -m vcp_cli workflow plan --id mvp-to-launch --json"
  ],
  "version": "v0.9.0",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf"
  ],
  "badges": [
    "workflow",
    "mvp",
    "launch"
  ]
}
