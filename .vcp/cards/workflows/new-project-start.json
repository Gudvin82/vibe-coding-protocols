{
  "id": "workflow-new-project-start",
  "type": "workflow",
  "name": "New Project Start Workflow",
  "summary": "Workflow card for New Project Start Workflow.",
  "use_when": [
    "A new idea or MVP needs initial discipline before implementation."
  ],
  "do_not_use_when": [
    "you expect the workflow file to execute automation by itself"
  ],
  "risk_level": "medium",
  "domains": [
    "workflow",
    "delivery-governance"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "implementation",
      "review"
    ],
    "ai_failure_modes": [
      "chat-only memory",
      "skipped validation"
    ],
    "project_state": [
      "new-project",
      "existing-repo"
    ],
    "risk_categories": [
      "route drift",
      "validation drift"
    ]
  },
  "entry_files": [
    ".vcp/workflows/new-project-start.json"
  ],
  "related_files": [
    "docs/workflows.md"
  ],
  "cli": [
    "python3 -m vcp_cli workflow show new-project-start"
  ],
  "outputs": [
    "starter route recommendation",
    "initial scope notes"
  ],
  "stop_conditions": [
    "Production code already exists",
    "Sensitive live behavior already exists"
  ],
  "validation": [
    "bash scripts/vibe-check.sh --starter"
  ],
  "version": "v0.9.4",
  "maturity": "stable",
  "recommended": false,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor"
  ],
  "badges": [
    "workflow"
  ]
}
