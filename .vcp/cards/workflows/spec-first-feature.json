{
  "id": "workflow-spec-first-feature",
  "type": "workflow",
  "name": "Spec-first Feature Workflow",
  "summary": "Workflow card for Spec-first Feature Workflow.",
  "use_when": [
    "A non-trivial feature request is too ambiguous to implement safely."
  ],
  "do_not_use_when": [
    "you expect the workflow file to execute automation by itself"
  ],
  "risk_level": "medium",
  "domains": [
    "workflow",
    "delivery-governance"
  ],
  "maps_to": {
    "sdlc_phase": [
      "planning",
      "implementation",
      "review"
    ],
    "ai_failure_modes": [
      "chat-only memory",
      "skipped validation"
    ],
    "project_state": [
      "new-project",
      "existing-repo"
    ],
    "risk_categories": [
      "route drift",
      "validation drift"
    ]
  },
  "entry_files": [
    ".vcp/workflows/spec-first-feature.json"
  ],
  "related_files": [
    "docs/workflows.md"
  ],
  "cli": [
    "python3 -m vcp_cli workflow show spec-first-feature"
  ],
  "outputs": [
    "PRD.md",
    "FEATURE_SPEC.md",
    "ACCEPTANCE_CRITERIA.md",
    "TASKS.md"
  ],
  "stop_conditions": [
    "The feature is still unclear after clarifying questions",
    "Acceptance criteria are not testable"
  ],
  "validation": [
    "python3 -m vcp_cli spec validate",
    "python3 -m vcp_cli backlog validate"
  ],
  "version": "v0.9.0",
  "maturity": "stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor"
  ],
  "badges": [
    "workflow"
  ]
}
