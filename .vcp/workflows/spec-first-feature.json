{
  "id": "spec-first-feature",
  "name": "Spec-first Feature Workflow",
  "trigger": "A non-trivial feature request is too ambiguous to implement safely.",
  "route": "spec-first-feature",
  "steps": [
    {
      "id": "classify",
      "name": "Route to spec-first",
      "action": "route",
      "command": "python3 -m vcp_cli route --profile spec-first --json"
    },
    {
      "id": "prd",
      "name": "Create PRD",
      "action": "spec",
      "command": "python3 -m vcp_cli spec template prd"
    },
    {
      "id": "feature",
      "name": "Create feature spec",
      "action": "spec",
      "command": "python3 -m vcp_cli spec template feature"
    },
    {
      "id": "tasks",
      "name": "Create task breakdown",
      "action": "spec",
      "command": "python3 -m vcp_cli spec template tasks"
    },
    {
      "id": "review",
      "name": "Review spec before implementation",
      "action": "review",
      "command": "python3 -m vcp_cli spec review --json"
    }
  ],
  "required_artifacts": [
    "protocols/spec-driven/README.md",
    "protocols/spec-driven/product-brief-to-prd.md",
    "protocols/spec-driven/feature-spec.md",
    "templates/specs/PRD.md",
    "templates/specs/FEATURE_SPEC.md",
    "templates/specs/ACCEPTANCE_CRITERIA.md",
    "templates/specs/TASKS.md"
  ],
  "outputs": [
    "PRD.md",
    "FEATURE_SPEC.md",
    "ACCEPTANCE_CRITERIA.md",
    "TASKS.md"
  ],
  "validation": [
    "python3 -m vcp_cli spec validate",
    "python3 -m vcp_cli backlog validate"
  ],
  "stop_conditions": [
    "The feature is still unclear after clarifying questions",
    "Acceptance criteria are not testable"
  ],
  "related_cards": [
    "spec-first-feature",
    "spec-lane",
    "prd",
    "feature-spec",
    "acceptance-criteria"
  ],
  "version": "v0.7.1"
}
