{
  "id": "ai-augmented-solo-squad",
  "name": "AI-Augmented Solo/Squad Control Path",
  "trigger": "Human-led solo developer or small team wants structured multi-agent work without autonomous orchestration claims.",
  "route": "ai-augmented-solo-squad",
  "steps": [
    {
      "id": "charter",
      "name": "Project control charter",
      "action": "artifact",
      "notes": "Define control boundaries before active AI work expands."
    },
    {
      "id": "change-intent",
      "name": "Change intent",
      "action": "artifact",
      "notes": "Capture what is changing and why before implementation starts."
    },
    {
      "id": "routing",
      "name": "Model routing",
      "action": "route",
      "command": "python3 -m vcp_cli route --profile production --json"
    },
    {
      "id": "profile",
      "name": "Rule profile",
      "action": "plan",
      "notes": "Choose nano, mini, or full instruction depth for the active agent."
    },
    {
      "id": "work",
      "name": "Work session",
      "action": "plan",
      "notes": "Execute human-led AI work with explicit review boundaries."
    },
    {
      "id": "proof",
      "name": "Evaluation receipt and proof",
      "action": "artifact",
      "command": "python3 -m vcp_cli evaluator receipt --json"
    },
    {
      "id": "pr-gate",
      "name": "PR Gate",
      "action": "review",
      "command": "python3 -m vcp_cli pr-gate explain --json"
    },
    {
      "id": "trust-check",
      "name": "Trust check",
      "action": "artifact",
      "command": "python3 -m vcp_cli trust-check --json"
    }
  ],
  "required_artifacts": [
    "templates/project-control-charter.md",
    "templates/reports/change-intent.md",
    "templates/reports/solo-squad-control-plan.md",
    "templates/reports/evaluation-receipt.md"
  ],
  "outputs": [
    "control charter",
    "change intent",
    "routing decision",
    "evaluation receipt",
    "trust-check evidence"
  ],
  "validation": [
    "python3 -m vcp_cli trust-check --json",
    "python3 -m vcp_cli evaluator receipt --json",
    "python3 -m vcp_cli check --fast --json"
  ],
  "stop_conditions": [
    "Human owner cannot review or approve the next step",
    "Change intent or control charter is missing",
    "Evidence trail is incomplete"
  ],
  "related_cards": [
    "agent-model-routing",
    "evaluator-token-budget",
    "project-control-charter",
    "change-intent",
    "proof-snapshot"
  ],
  "version": "v0.9.5"
}
