{
  "id": "new-project-start",
  "name": "New Project Start Workflow",
  "trigger": "A new idea or MVP needs initial discipline before implementation.",
  "route": "starter",
  "steps": [
    {
      "id": "classify",
      "name": "Classify project state",
      "action": "route",
      "command": "python3 -m vcp_cli route --profile new-project --json"
    },
    {
      "id": "intake",
      "name": "Read intake entrypoints",
      "action": "inspect",
      "notes": "Open START_HERE.md and AI_INTAKE.md."
    },
    {
      "id": "brief",
      "name": "Create product brief",
      "action": "artifact",
      "notes": "Write product brief and PROJECT_MAP before code."
    }
  ],
  "required_artifacts": [
    "START_HERE.md",
    "PROJECT_MAP.md"
  ],
  "outputs": [
    "starter route recommendation",
    "initial scope notes"
  ],
  "validation": [
    "bash scripts/vibe-check.sh --starter"
  ],
  "stop_conditions": [
    "Production code already exists",
    "Sensitive live behavior already exists"
  ],
  "related_cards": [
    "starter",
    "adoption-pack",
    "project-map"
  ],
  "version": "v0.8.8"
}
