{
  "id": "spec-driven-adoption",
  "name": "Spec-driven Adoption Workflow",
  "trigger": "A feature needs spec, adoption planning, and release control before implementation expands.",
  "route": "spec-driven-adoption",
  "steps": [
    {
      "id": "onboard",
      "name": "Onboard",
      "action": "inspect",
      "command": "python3 -m vcp_cli onboard --json"
    },
    {
      "id": "classify",
      "name": "Classify",
      "action": "route",
      "command": "python3 -m vcp_cli classify --json"
    },
    {
      "id": "spec-gate",
      "name": "Spec quality gate",
      "action": "spec",
      "command": "python3 -m vcp_cli spec quality-gate --json"
    },
    {
      "id": "adopt",
      "name": "Plan spec adoption",
      "action": "adopt",
      "command": "python3 -m vcp_cli adopt plan --pack spec-foundation --json"
    },
    {
      "id": "release",
      "name": "Release check",
      "action": "release-check",
      "command": "python3 -m vcp_cli release-check --json"
    }
  ],
  "required_artifacts": [
    "templates/specs/feature-spec.md",
    "templates/specs/implementation-plan.md",
    "templates/specs/task-breakdown.md"
  ],
  "outputs": [
    "spec-guided adoption plan",
    "release readiness summary"
  ],
  "validation": [
    "python3 -m vcp_cli spec quality-gate --json",
    "python3 -m vcp_cli release-check --json"
  ],
  "stop_conditions": [
    "spec artifacts are still missing for a risky change"
  ],
  "related_cards": [
    "spec-foundation",
    "pr-gate-approval-model"
  ],
  "version": "v0.9.5"
}
