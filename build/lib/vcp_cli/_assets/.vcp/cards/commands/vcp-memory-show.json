{
  "id": "vcp-memory-show",
  "type": "command",
  "name": "Memory Show",
  "summary": "Show explicit project-memory contents from a local JSON file.",
  "use_when": [
    "the current local governance state must be reviewed"
  ],
  "do_not_use_when": [
    "hidden or personal memory is expected"
  ],
  "risk_level": "low",
  "domains": [
    "cli",
    "governance"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "missing context"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "governance drift"
    ]
  },
  "entry_files": [
    "vcp_cli/memory_cmd.py"
  ],
  "related_files": [
    "docs/project-memory.md"
  ],
  "cli": [
    "python3 -m vcp_cli memory show .vcp/project-memory.example.json --json"
  ],
  "outputs": [
    "project memory view"
  ],
  "stop_conditions": [
    "local project memory is project-scoped only"
  ],
  "validation": [
    "python3 -m vcp_cli memory show .vcp/project-memory.example.json --json"
  ],
  "version": "v0.8.4",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "local",
    "governance"
  ]
}
