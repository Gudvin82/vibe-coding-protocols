{
  "id": "vcp-dashboard-build",
  "type": "command",
  "name": "Dashboard Build",
  "summary": "Generate a local dashboard artifact with HTML, markdown, and JSON summaries from existing repository data.",
  "use_when": [
    "a local dashboard/report artifact is needed for demos or inspection"
  ],
  "do_not_use_when": [
    "a hosted dashboard or telemetry-backed service is expected"
  ],
  "risk_level": "medium",
  "domains": [
    "cli",
    "dashboard"
  ],
  "maps_to": {
    "sdlc_phase": [
      "review"
    ],
    "ai_failure_modes": [
      "dashboard overclaim"
    ],
    "project_state": [
      "new",
      "existing MVP",
      "production"
    ],
    "risk_categories": [
      "tooling clarity"
    ]
  },
  "entry_files": [
    "vcp_cli/dashboard_cmd.py"
  ],
  "related_files": [
    "docs/dashboard.md",
    "docs/metrics-board.md"
  ],
  "cli": [
    "python3 -m vcp_cli dashboard build --output ./vcp-dashboard --json"
  ],
  "outputs": [
    "local dashboard artifact"
  ],
  "stop_conditions": [
    "no hosted server",
    "no telemetry",
    "no writes outside output directory"
  ],
  "validation": [
    "python3 -m vcp_cli dashboard build --output /tmp/vcp-dashboard-test --json"
  ],
  "version": "v0.8.4",
  "maturity": "local-stable",
  "recommended": true,
  "platforms": [
    "codex-cli",
    "claude-code",
    "cursor",
    "windsurf",
    "github-copilot"
  ],
  "badges": [
    "command",
    "dashboard",
    "local"
  ]
}
