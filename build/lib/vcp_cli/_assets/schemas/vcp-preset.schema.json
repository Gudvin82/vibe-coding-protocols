{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gudvin82/vibe-coding-protocols/schemas/vcp-preset.schema.json",
  "title": "VCP Preset",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "default_spec_depth", "recommended_routes", "required_gates", "notes"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "default_spec_depth": {"type": "string", "enum": ["no-spec", "spec-lite", "full-spec", "governed-spec"]},
    "recommended_routes": {"type": "array", "items": {"type": "string"}},
    "recommended_packs": {"type": "array", "items": {"type": "string"}},
    "required_gates": {"type": "array", "items": {"type": "string"}},
    "public_growth_options": {"type": "array", "items": {"type": "string"}},
    "risk_defaults": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
