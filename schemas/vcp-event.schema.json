{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gudvin82/vibe-coding-protocols/schemas/vcp-event.schema.json",
  "title": "VCP Event",
  "type": "object",
  "required": [
    "id",
    "type",
    "severity",
    "summary",
    "source",
    "timestamp",
    "environment",
    "evidence",
    "related_files",
    "related_backlog_items",
    "recommended_next_action",
    "redaction_status",
    "version"
  ],
  "properties": {
    "id": {"type": "string"},
    "type": {"type": "string", "enum": ["review_finding", "prod_error", "audit_risk", "api_intake_risk", "public_growth_issue", "backlog_transition", "spec_gap", "diagnostic_warning", "release_gate_failure", "validation_failure"]},
    "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "INFO"]},
    "summary": {"type": "string"},
    "source": {"type": "string"},
    "timestamp": {"type": "string"},
    "environment": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "related_files": {"type": "array", "items": {"type": "string"}},
    "related_backlog_items": {"type": "array", "items": {"type": "string"}},
    "recommended_next_action": {"type": "string"},
    "redaction_status": {"type": "string", "enum": ["no-sensitive-data", "redacted", "needs-review"]},
    "version": {"type": "string", "const": "v0.5.9"}
  },
  "additionalProperties": false
}
