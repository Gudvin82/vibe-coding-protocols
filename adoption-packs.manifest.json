      "expected_report_template": [
        "templates/reports/refactoring-report.md",
        "templates/reports/code-review-report.md"
      ],
      "review_gate_requirement": "Required after the refactoring slice.",
      "next_safe_step": "Choose one small behavior-preserving refactor."
    },
